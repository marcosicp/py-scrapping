# Keep the image build context small and deterministic.
# The frontend bundle is not committed and is produced by the `frontend` stage,
# so a developer's local build must never leak into this context.
Dockerfile
README.md
*.pyc
*.pyo
*.pyd
__pycache__
.pytest_cache

# Never ship these
# .env is gitignored so a clone-based build never sees it, but a local
# `docker build .` would bake the secrets into a layer through `COPY . ./`.
.env
.env.*
static/
.git/
.venv/
adminpro/node_modules/
adminpro/dist/
adminpro/.angular/

# Not needed at runtime
docs/
odd/
.DS_Store
